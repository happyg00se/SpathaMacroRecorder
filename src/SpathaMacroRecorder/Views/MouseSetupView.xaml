<Window x:Class="SpathaMacroRecorder.Views.MouseSetupView"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SpathaMacroRecorder.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="12"
        Title="{loc:Tr MouseSetupTitle}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource HeaderTextStyle}" Text="{loc:Tr MouseSetupHeader}" />

        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                   Text="{loc:Tr MouseSetupP1}" />

        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                   Text="{loc:Tr MouseSetupP2}" />

        <Border Margin="0,16,0,0"
                Padding="16"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Margin="0,0,0,10" Text="{loc:Tr MouseSetupAssign}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{loc:Tr Side1}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{loc:Tr Side2}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{loc:Tr Side3}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{loc:Tr Side4}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{loc:Tr Side5}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{loc:Tr Side6}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{loc:Tr MouseSetupDpi}" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                   Text="{loc:Tr MouseSetupP3}" />

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                   Text="{loc:Tr MouseSetupP4}" />

        <Button Margin="0,20,0,0"
                Width="110"
                HorizontalAlignment="Right"
                Click="Close_Click"
                Content="{loc:Tr Close}"
                IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" />
    </StackPanel>
</Window>
