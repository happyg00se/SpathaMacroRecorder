<Window x:Class="SpathaMacroRecorder.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SpathaMacroRecorder.Models"
        Title="SpathaMacroRecorder"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="12">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptTextBlock" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="InputTextBox" Margin="0,0,0,16" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="90"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"
                    Content="{loc:Tr Cancel}"
                    IsCancel="True" />
            <Button x:Name="OkButton"
                    Width="90"
                    Click="Ok_Click"
                    Content="{loc:Tr SaveShort}"
                    IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
