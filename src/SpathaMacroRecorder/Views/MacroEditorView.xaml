<UserControl x:Class="SpathaMacroRecorder.Views.MacroEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SpathaMacroRecorder.Models"
             xmlns:converters="clr-namespace:SpathaMacroRecorder.Views.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:StepTypeConverter x:Key="StepTypeConverter" />
        <converters:StepKeyOrButtonConverter x:Key="StepKeyOrButtonConverter" />
        <converters:StepActionConverter x:Key="StepActionConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Macros of the current profile -->
        <DockPanel Grid.Row="0" Margin="12,12,12,6">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource HeaderTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" Text="{loc:Tr Macros}" />
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="30" Command="{Binding AddMacroCommand}" Content="+" ToolTip="{loc:Tr NewMacroTip}" />
                <Button Margin="4,0,0,0"
                        Click="SelectAllMacros_Click"
                        Content="{loc:Tr SelectAll}"
                        ToolTip="{loc:Tr SelectAllMacrosTip}" />
                <Button Width="30"
                        Margin="4,0,0,0"
                        Command="{Binding DeleteMacroCommand}"
                        Content="🗑"
                        ToolTip="{loc:Tr DeleteMacrosTip}" />
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="MacrosList"
                  Grid.Row="1"
                  Margin="12,0,12,8"
                  DisplayMemberPath="Name"
                  ItemsSource="{Binding CurrentProfile.Macros}"
                  SelectedItem="{Binding SelectedMacro}"
                  PreviewKeyDown="MacrosList_PreviewKeyDown"
                  SelectionChanged="MacrosList_SelectionChanged"
                  SelectionMode="Extended" />

        <!-- Steps of the selected macro -->
        <DockPanel Grid.Row="2" Margin="12,4,12,6">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource HeaderTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" Text="{loc:Tr Steps}" />
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding AddStepCommand}" Content="{loc:Tr Add}" ToolTip="{loc:Tr AddStepTip}" />
                <Button Margin="4,0,0,0"
                        Command="{Binding ZeroDelaysCommand}"
                        Content="{loc:Tr Delay0}"
                        ToolTip="{loc:Tr Delay0Tip}" />
                <Button Width="30" Margin="4,0,0,0" Command="{Binding MoveStepUpCommand}" Content="↑" ToolTip="{loc:Tr MoveUpTip}" />
                <Button Width="30" Margin="4,0,0,0" Command="{Binding MoveStepDownCommand}" Content="↓" ToolTip="{loc:Tr MoveDownTip}" />
                <Button Margin="4,0,0,0" Click="SelectAllSteps_Click" Content="{loc:Tr SelectAll}" ToolTip="{loc:Tr SelectAllStepsTip}" />
                <Button Margin="4,0,0,0" Command="{Binding DeleteStepCommand}" Content="{loc:Tr Delete}" ToolTip="{loc:Tr DeleteStepsTip}" />
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="3"
                  Margin="12,0,12,12"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  LoadingRow="StepsGrid_LoadingRow"
                  ItemsSource="{Binding SelectedMacro.Steps}"
                  RowEditEnding="StepsGrid_RowEditEnding"
                  SelectedItem="{Binding SelectedStep}"
                  PreviewKeyDown="StepsGrid_PreviewKeyDown"
                  SelectionChanged="StepsGrid_SelectionChanged"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  x:Name="StepsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Width="36"
                                     Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"
                                     Header="#"
                                     IsReadOnly="True" />
                <DataGridTextColumn Width="90"
                                     Binding="{Binding Converter={StaticResource StepTypeConverter}}"
                                     Header="{loc:Tr ColType}"
                                     IsReadOnly="True" />
                <DataGridTextColumn Width="120"
                                     Binding="{Binding Converter={StaticResource StepKeyOrButtonConverter}}"
                                     Header="{loc:Tr ColKey}"
                                     IsReadOnly="True" />
                <DataGridTextColumn Width="80"
                                     Binding="{Binding Converter={StaticResource StepActionConverter}}"
                                     Header="{loc:Tr ColAction}"
                                     IsReadOnly="True" />
                <DataGridTextColumn Width="*"
                                     Binding="{Binding DelayBeforeMs, UpdateSourceTrigger=LostFocus}"
                                     Header="{loc:Tr ColDelay}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
