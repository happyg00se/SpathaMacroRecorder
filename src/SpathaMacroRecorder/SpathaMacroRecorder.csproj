<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SpathaMacroRecorder</RootNamespace>
    <AssemblyName>SpathaMacroRecorder</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\spatha.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Свойства файла в проводнике. Предупреждение "Неизвестный издатель" снимает только
         подпись сертификатом Authenticode, но без этих полей файл выглядит вовсе безымянным. -->
    <Product>Spatha Macro Recorder</Product>
    <AssemblyTitle>Spatha Macro Recorder</AssemblyTitle>
    <Description>Запись и воспроизведение макросов для ASUS ROG Spatha X</Description>
    <Company>r4v3r_63</Company>
    <Copyright>Copyright (c) 2026 r4v3r_63</Copyright>
    <Version>1.0.7</Version>
    <FileVersion>1.0.7.0</FileVersion>
    <AssemblyVersion>1.0.7.0</AssemblyVersion>
    <!-- Название сборки для людей. Видно в заголовке окна и в строке состояния — по скриншоту
         сразу понятно, какая сборка запущена. Повышать с каждым релизом. -->
    <InformationalVersion>Release 1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- InvariantGlobalization включать нельзя: привязки WPF запрашивают культуру, и с
         инвариантной культурой любая из них падает с "Cannot find non-neutral culture". -->
    <!-- Позволяет собирать (но не запускать) проект, нацеленный на Windows, вне Windows —
         нужно для сборки/проверки этого репозитория с macOS. На самой Windows не влияет. -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpathaMacroRecorder.Tests" />
  </ItemGroup>


  <ItemGroup>
    <!-- Встраивается в сборку, поэтому оказывается внутри single-file exe и не требует
         отдельного файла рядом с программой. -->
    <Resource Include="Resources\spatha.png" />
    <Resource Include="Resources\spatha.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
