<Window x:Class="SpathaMacroRecorder.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SpathaMacroRecorder.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SpathaMacroRecorder.Views"
        mc:Ignorable="d"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="12"
        Title="Spatha Macro Recorder"
        Icon="pack://application:,,,/SpathaMacroRecorder;component/Resources/spatha.ico"
        Width="1120"
        Height="780"
        MinWidth="900"
        MinHeight="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0" Margin="28,22,28,0">
            <TextBlock FontSize="22" FontWeight="Light" Foreground="{StaticResource TextPrimaryBrush}">
                <Run Text="SPATHA" /><Run Foreground="{StaticResource AccentBrush}" Text=" MACRO" />
            </TextBlock>
            <TextBlock Margin="0,2,0,0"
                       Style="{StaticResource SecondaryTextStyle}"
                       Text="{Binding MouseHero.ProfileName, StringFormat='Profile: {0}'}" />
        </StackPanel>

        <!-- FAQ -->
        <Button Grid.Row="0"
                Width="38"
                Height="38"
                Margin="0,20,28,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Command="{Binding OpenFaqCommand}"
                Content="?"
                FontSize="17"
                ToolTip="{loc:Tr FaqTip}">
            <Button.Style>
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="Circle"
                                        Background="{StaticResource PanelBackgroundBrush}"
                                        BorderBrush="{StaticResource TextSecondaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="19">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Circle" Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- Мышь -->
        <views:MouseHeroView Grid.Row="1" DataContext="{Binding MouseHero}" />

        <!-- Сохранение назначений -->
        <Button Grid.Row="1"
                Margin="28,0,0,18"
                Padding="30,12"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Command="{Binding MacroEditor.SaveProfileCommand}"
                Content="{loc:Tr Save}"
                FontSize="14"
                Style="{StaticResource AccentButtonStyle}"
                ToolTip="{loc:Tr SaveTip}" />

        <!-- Нижняя панель -->
        <Border Grid.Row="2"
                Background="#141416"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Margin="20,12">
            <DockPanel>
                <Button Padding="18,8"
                        Command="{Binding OpenEditorCommand}"
                        Content="{loc:Tr Settings}"
                        FontSize="13"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTip="{loc:Tr SettingsTip}" />

                <Button Margin="10,0,0,0"
                        Padding="14,8"
                        Command="{Binding OpenSettingsCommand}"
                        Content="{loc:Tr Preferences}" />

                <Button Margin="10,0,0,0"
                        Padding="14,8"
                        Command="{Binding OpenMouseSetupCommand}"
                        Content="{loc:Tr MouseSetup}" />

                <StackPanel DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource AccentBrush}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
                </StackPanel>
            </DockPanel>

            <!-- Диагностика: сборка, перехват, последний сигнал кнопки мыши и что из него вышло -->
            <TextBlock Margin="0,8,0,0"
                       FontSize="11"
                       Style="{StaticResource SecondaryTextStyle}"
                       Text="{Binding DiagnosticsText}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DiagnosticsText}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
